<UserControl x:Class="PersonalWorkspace.App.Views.TaskWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource ContentPadding}" RowSpacing="{StaticResource Space16}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="{StaticResource Space16}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" />
            <Button Grid.Column="1" Content="Browse tasks" Command="{Binding BrowseCommand}" Visibility="{Binding IsToday, Converter={StaticResource BoolVisibility}}" />
            <Button Grid.Column="2" Content="+ Task" Command="{Binding NewTaskCommand}" IsEnabled="{Binding IsIdle}" Visibility="{Binding IsList, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="NewTask" />
        </Grid>
        <StackPanel Grid.Row="1" Spacing="{StaticResource Space8}" Visibility="{Binding CanFilter, Converter={StaticResource BoolVisibility}}">
            <TextBox PlaceholderText="Filter task titles…" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter task titles" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}">
                <ComboBox Header="Tag" ItemsSource="{Binding TagFilters}" DisplayMemberPath="Name" SelectedItem="{Binding TagFilter, Mode=TwoWay}" AutomationProperties.AutomationId="TagFilter" />
                <ComboBox Header="Space" ItemsSource="{Binding SpaceFilters}" DisplayMemberPath="Name" SelectedItem="{Binding SpaceFilter, Mode=TwoWay}" Visibility="{Binding CanChooseSpaceFilter, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="SpaceFilter" />
                <Button Content="Manage tags and spaces" Command="{Binding ManageOrganizationCommand}" VerticalAlignment="Bottom" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="{StaticResource Space8}">
            <TextBlock Text="{Binding Error}" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource Danger}" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
        <Grid Grid.Row="3" Visibility="{Binding IsList, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource BodyStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" />
            <ListView ItemsSource="{Binding Rows}" SelectionMode="None" IsEnabled="{Binding IsIdle}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Tasks">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="{StaticResource Space16}" Padding="{StaticResource TaskRowPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Button Content="{Binding HierarchyTitle}" Click="OnOpen" Tag="{Binding}" Style="{StaticResource TaskTitleButtonStyle}" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="{Binding Title}" />
                                <TextBlock Text="{Binding ContextText}" FontSize="{StaticResource Small}" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding PriorityText}" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding ScheduledText}" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Content="Actions" AutomationProperties.Name="Task actions">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Open" Click="OnOpen" Tag="{Binding}" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}" />
                                        <MenuFlyoutItem Text="{Binding CompletionLabel}" Click="OnToggleDone" Tag="{Binding}" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}" />
                                        <MenuFlyoutItem Text="Duplicate" Click="OnDuplicate" Tag="{Binding}" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}" />
                                        <MenuFlyoutItem Text="Archive" Click="OnArchive" Tag="{Binding}" Visibility="{Binding CanArchive, Converter={StaticResource BoolVisibility}}" />
                                        <MenuFlyoutItem Text="Restore" Click="OnRestore" Tag="{Binding}" Visibility="{Binding CanRestore, Converter={StaticResource BoolVisibility}}" />
                                        <MenuFlyoutItem Text="Move to Trash" Click="OnTrash" Tag="{Binding}" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}" />
                                        <MenuFlyoutItem Text="Permanently delete" Click="OnPermanentDelete" Tag="{Binding}" Visibility="{Binding IsDeleted, Converter={StaticResource BoolVisibility}}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <ScrollViewer Grid.Row="3" Visibility="{Binding IsEditor, Converter={StaticResource BoolVisibility}}" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="{StaticResource Space24}" MaxWidth="{StaticResource TaskDetailWidth}" HorizontalAlignment="Stretch">
                <Button Content="Back" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
                <TextBox Header="Title" Text="{Binding EditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="TaskTitle" />
                <StackPanel Spacing="{StaticResource Space12}">
                    <ComboBox Header="Task type" ItemsSource="{Binding ValueEditor.Types}" SelectedItem="{Binding ValueEditor.Type, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="TaskValueType" />
                    <StackPanel Spacing="{StaticResource Space12}" Visibility="{Binding ValueEditor.HasValue, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="Value / Progress" FontSize="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ValueEditor.Hint}" Style="{StaticResource BodyStyle}" />
                        <Grid ColumnSpacing="{StaticResource Space16}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBox Header="Target" Text="{Binding ValueEditor.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="TaskTarget" />
                            <TextBox Grid.Column="1" Header="Actual (optional)" Text="{Binding ValueEditor.Actual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TaskActual" />
                        </Grid>
                        <TextBox Header="Currency code" Text="{Binding ValueEditor.Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" Visibility="{Binding ValueEditor.IsCurrency, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TaskCurrency" />
                        <TextBox Header="Unit label" Text="{Binding ValueEditor.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" Visibility="{Binding ValueEditor.IsCustom, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TaskUnit" />
                        <TextBlock Text="{Binding ValueEditor.Progress}" Style="{StaticResource BodyStyle}" AutomationProperties.AutomationId="TaskValueProgress" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ValueEditor.VisualProgress}" AutomationProperties.Name="Value progress" />
                        <Button Content="Record actual" Command="{Binding RecordActualCommand}" IsEnabled="{Binding CanSave}" HorizontalAlignment="Left" Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="RecordActual" />
                        <TextBlock Text="Record actual saves only the current result. Use Save below for type, target and other task changes." Style="{StaticResource BodyStyle}" Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space16}">
                    <ComboBox Header="Status" ItemsSource="{Binding Statuses}" SelectedItem="{Binding EditorStatus, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TaskStatus" />
                    <ComboBox Header="Priority" ItemsSource="{Binding Priorities}" SelectedItem="{Binding EditorPriority, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="TaskPriority" />
                    <CalendarDatePicker x:Name="ScheduledDatePicker" Header="Scheduled date (optional)" PlaceholderText="Unscheduled" DateChanged="OnScheduledDateChanged" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="TaskScheduledDate" />
                    <Button Content="Clear date" Command="{Binding UnscheduleCommand}" VerticalAlignment="Bottom" IsEnabled="{Binding IsIdle}" />
                </StackPanel>
                <TextBox Header="Description" Text="{Binding EditorDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="{StaticResource TaskDescriptionHeight}" IsEnabled="{Binding IsIdle}" Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TaskDescription" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                    <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveTask" />
                    <Button Content="Duplicate" Click="OnDuplicate" Tag="{Binding Detail}" IsEnabled="{Binding CanSave}" Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="Archive" Click="OnArchive" Tag="{Binding Detail}" IsEnabled="{Binding CanSave}" Visibility="{Binding Detail.CanArchive, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="Restore" Click="OnRestore" Tag="{Binding Detail}" IsEnabled="{Binding CanSave}" Visibility="{Binding Detail.IsArchived, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="Move to Trash" Click="OnTrash" Tag="{Binding Detail}" IsEnabled="{Binding CanSave}" Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <TextBlock Text="Select Save to keep your changes." Style="{StaticResource BodyStyle}" />
                <StackPanel Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" Spacing="{StaticResource Space12}">
                    <TextBlock Text="{Binding Detail.Context}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
                    <Button Content="Open parent" Click="OnOpen" Tag="{Binding Parent}" IsEnabled="{Binding Parent.CanEdit}" HorizontalAlignment="Left" Visibility="{Binding HasParent, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Text="Subtasks" FontSize="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource BodyStyle}" AutomationProperties.AutomationId="SubtaskProgress" />
                    <TextBlock Text="Subtask and dependency actions save immediately." Style="{StaticResource BodyStyle}" />
                    <ItemsControl ItemsSource="{Binding Subtasks}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource TaskRowPadding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button Content="{Binding HierarchyTitle}" Click="OnOpen" Tag="{Binding}" IsEnabled="{Binding CanEdit}" Style="{StaticResource TaskTitleButtonStyle}" />
                                    <TextBlock Text="{Binding ContextText}" FontSize="{StaticResource Small}" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="{Binding CompletionLabel}" Click="OnToggleDone" Tag="{Binding}" IsEnabled="{Binding CanEdit}" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Header="Subtask title" Text="{Binding SubtaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SubtaskTitle" />
                    <Button Content="+ Add subtask" Command="{Binding AddSubtaskCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="Blocked by" FontSize="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding DependencyText}" Style="{StaticResource BodyStyle}" AutomationProperties.AutomationId="DependencySummary" />
                    <ItemsControl ItemsSource="{Binding Dependencies}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource TaskRowPadding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button Content="{Binding Title}" Click="OnOpen" Tag="{Binding}" IsEnabled="{Binding CanEdit}" Style="{StaticResource TaskTitleButtonStyle}" />
                                    <TextBlock Text="{Binding ContextText}" FontSize="{StaticResource Small}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Remove dependency" Click="OnRemoveDependency" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="+ Add dependency" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="{StaticResource Space8}">
                            <TextBox Header="Filter task titles" Text="{Binding DependencyFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DependencyFilter" />
                            <ListView ItemsSource="{Binding DependencyCandidates}" SelectionMode="None" MaxHeight="{StaticResource EventListHeight}">
                                <ListView.ItemTemplate><DataTemplate>
                                    <Button Content="{Binding Title}" Click="OnAddDependency" Tag="{Binding}" AutomationProperties.Name="{Binding Title}" />
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" Spacing="{StaticResource Space12}">
                    <TextBlock Text="Organization" FontSize="{StaticResource SectionTitle}" />
                    <TextBlock Text="Assign or remove tags and spaces below. These changes save immediately." Style="{StaticResource BodyStyle}" />
                    <Expander IsEnabled="{Binding IsIdle}" Header="Tags" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding TagChoices}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource TaskRowPadding}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse Width="{StaticResource OrganizationIndicatorSize}" Height="{StaticResource OrganizationIndicatorSize}" Fill="{Binding Color, Converter={StaticResource OrganizationColor}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="{Binding ActionLabel}" Click="OnAssignment" Tag="{Binding}" AutomationProperties.Name="{Binding ActionDescription}" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander IsEnabled="{Binding IsIdle}" Header="Spaces" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding SpaceChoices}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource TaskRowPadding}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse Width="{StaticResource OrganizationIndicatorSize}" Height="{StaticResource OrganizationIndicatorSize}" Fill="{Binding Color, Converter={StaticResource OrganizationColor}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="{Binding ActionLabel}" Click="OnAssignment" Tag="{Binding}" AutomationProperties.Name="{Binding ActionDescription}" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Button Content="Manage tags and spaces" Command="{Binding ManageOrganizationCommand}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsDetail, Converter={StaticResource BoolVisibility}}" Spacing="{StaticResource Space8}">
                    <TextBlock Text="Created" FontSize="{StaticResource Small}" Foreground="{ThemeResource TextSecondary}" />
                    <TextBlock Text="{Binding CreatedText}" Style="{StaticResource BodyStyle}" />
                    <TextBlock Text="Last modified" FontSize="{StaticResource Small}" Foreground="{ThemeResource TextSecondary}" />
                    <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource BodyStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
