<ContentDialog x:Class="PersonalWorkspace.App.Views.SearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Search PersonalWorkspace" CloseButtonText="Close" PreviewKeyDown="OnKeyDown">
    <Grid MinWidth="480" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBox x:Name="QueryInput" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search this Profile…" MaxLength="256" AutomationProperties.AutomationId="GlobalSearchQuery"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <CheckBox Content="Include archived" IsChecked="{Binding IncludeArchived, Mode=TwoWay}"/>
            <Button Content="Retry" Click="OnRetry"/>
            <Button Content="Rebuild index" Click="OnRebuild"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <ListView x:Name="ResultList" Grid.Row="3" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}" MaxHeight="440" IsItemClickEnabled="True" ItemClick="OnResultClick" AutomationProperties.AutomationId="GlobalSearchResults">
            <ListView.ItemTemplate><DataTemplate>
                <StackPanel Padding="4,8" Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" MaxLines="2"/>
                </StackPanel>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
