<UserControl x:Class="PersonalWorkspace.App.Views.OrganizationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource ContentPadding}" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="{StaticResource Space24}">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                <Button Content="Spaces" Command="{Binding ShowSpacesCommand}" IsEnabled="{Binding IsIdle}" />
                <Button Content="Tags" Command="{Binding ShowTagsCommand}" IsEnabled="{Binding IsIdle}" />
                <Button Content="+ New" Command="{Binding NewCommand}" IsEnabled="{Binding IsIdle}" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource Danger}" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
            <StackPanel Spacing="{StaticResource Space12}" MaxWidth="{StaticResource ProfileFormWidth}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding EditorHeading}" FontSize="{StaticResource SectionTitle}" />
                <TextBox IsEnabled="{Binding IsIdle}" Header="Name" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="OrganizationName" />
                <ComboBox IsEnabled="{Binding IsIdle}" Header="Color (optional)" ItemsSource="{Binding Colors}" SelectedItem="{Binding Color, Mode=TwoWay}" AutomationProperties.Name="Organization color" />
                <TextBox IsEnabled="{Binding IsIdle}" Header="Description (optional)" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Visibility="{Binding IsSpace, Converter={StaticResource BoolVisibility}}" />
                <TextBox IsEnabled="{Binding IsIdle}" Header="Icon or emoji (optional)" Text="{Binding Icon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsSpace, Converter={StaticResource BoolVisibility}}" />
                <Button IsEnabled="{Binding IsIdle}" Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveOrganization" />
            </StackPanel>
            <TextBlock Text="Archiving a space keeps its tasks and assignments. Restore it here whenever needed." Style="{StaticResource BodyStyle}" Visibility="{Binding IsSpace, Converter={StaticResource BoolVisibility}}" />
            <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding IsIdle}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Padding="{StaticResource TaskRowPadding}" ColumnSpacing="{StaticResource Space12}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Ellipse Width="{StaticResource OrganizationIndicatorSize}" Height="{StaticResource OrganizationIndicatorSize}" Fill="{Binding Color, Converter={StaticResource OrganizationColor}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Icon}" /><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding State}" Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Edit" Click="OnEdit" Tag="{Binding}" />
                        <Button Grid.Column="3" Content="{Binding ArchiveLabel}" Click="OnArchive" Tag="{Binding}" Visibility="{Binding IsSpace, Converter={StaticResource BoolVisibility}}" />
                        <Button Grid.Column="4" Content="Delete" Click="OnDelete" Tag="{Binding}" Visibility="{Binding IsTag, Converter={StaticResource BoolVisibility}}" />
                    </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
