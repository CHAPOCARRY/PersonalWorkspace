<UserControl x:Class="PersonalWorkspace.App.Views.TrackerListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource ContentPadding}" RowSpacing="{StaticResource Space8}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><TextBlock Text="Trackers" FontSize="{StaticResource SectionTitle}" /><Button Content="+ Tracker" Command="{Binding NewTrackerCommand}" HorizontalAlignment="Right" Visibility="{Binding IsLibrary, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}" /></Grid>
        <TextBlock Grid.Row="1" Text="{Binding Error}" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource Danger}" AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="2">
            <TextBlock Text="No Trackers here." Style="{StaticResource BodyStyle}" Visibility="{Binding HasRows, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" />
            <ListView ItemsSource="{Binding Rows}" SelectionMode="None" HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsIdle}">
                <ListView.ItemTemplate><DataTemplate>
                    <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource TaskRowPadding}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Button Content="{Binding Title}" Tag="{Binding}" Click="OnOpen" Style="{StaticResource TaskTitleButtonStyle}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyStyle}" />
                            <TextBlock Text="{Binding Frequency}" Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding RecordLabel}" Tag="{Binding}" Click="OnOpen" Visibility="{Binding CanRecord, Converter={StaticResource BoolVisibility}}" />
                        <Button Grid.Column="2" Content="Actions" Tag="{Binding}" AutomationProperties.Name="Tracker actions"><Button.Flyout><MenuFlyout Opening="OnActionsOpening" /></Button.Flyout></Button>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
