<UserControl x:Class="PersonalWorkspace.App.Views.ListWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource ContentPadding}" ColumnSpacing="{StaticResource Space24}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid RowSpacing="{StaticResource Space12}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Lists" Style="{StaticResource PageTitleStyle}"/>
            <Button Grid.Row="1" Content="New List" Command="{Binding NewListCommand}" IsEnabled="{Binding IsIdle}"/>
            <ComboBox Grid.Row="2" ItemsSource="{Binding Collections}" SelectedItem="{Binding Collection, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="ListCollection" AutomationProperties.Name="List collection"/>
            <ListView Grid.Row="3" ItemsSource="{Binding Rows}" SelectionMode="None" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="ListLibrary">
                <ListView.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding}" Click="OnOpen" Style="{StaticResource TaskTitleButtonStyle}" AutomationProperties.Name="{Binding Title}"/></DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Column="1" RowSpacing="{StaticResource Space12}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="ListHeading"/>
            <StackPanel Grid.Row="1" Spacing="{StaticResource Space4}">
                <TextBlock Text="{Binding Error}" Foreground="{ThemeResource Danger}" TextWrapping="Wrap" AutomationProperties.AutomationId="ListError" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding Notice}" Foreground="{ThemeResource Success}" TextWrapping="Wrap" AutomationProperties.AutomationId="ListNotice" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding Context}" Style="{StaticResource BodyStyle}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource Space8}" Visibility="{Binding HasDetail, Converter={StaticResource BoolVisibility}}">
                <Button Content="List actions" Tag="{Binding DetailRow}" IsEnabled="{Binding IsIdle}"><Button.Flyout><MenuFlyout Opening="OnListActions"/></Button.Flyout></Button>
                <TextBlock Text="{Binding ItemCount}" VerticalAlignment="Center" Style="{StaticResource BodyStyle}"/>
            </StackPanel>
            <Expander Grid.Row="3" Header="List details" Visibility="{Binding ShowEditor, Converter={StaticResource BoolVisibility}}" IsExpanded="{Binding IsCreating}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="360"><ContentControl IsEnabled="{Binding CanEdit}" HorizontalContentAlignment="Stretch"><StackPanel Spacing="{StaticResource Space8}">
                    <TextBox Header="Title" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.AutomationId="ListTitle"/>
                    <TextBox Header="Description (optional)" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="50000" MaxHeight="96" AutomationProperties.AutomationId="ListDescription"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space16}">
                        <CheckBox Content="Show quantity" IsChecked="{Binding ShowQuantity, Mode=TwoWay}" AutomationProperties.AutomationId="ListShowQuantity"/>
                        <CheckBox Content="Show prices" IsChecked="{Binding ShowPrices, Mode=TwoWay}" AutomationProperties.AutomationId="ListShowPrices"/>
                        <TextBox Header="Currency (optional)" Text="{Binding CurrencyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowPrices, Converter={StaticResource BoolVisibility}}" MaxLength="3" Width="150" AutomationProperties.AutomationId="ListCurrency"/>
                    </StackPanel>
                    <TextBlock Text="Hiding quantity or prices preserves saved values. Save changes before navigating." Style="{StaticResource BodyStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"><Button Content="Save List" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveList"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></StackPanel>
                    <ItemsControl ItemsSource="{Binding Assignments}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding ActionDescription}" Tag="{Binding}" Click="OnAssign" HorizontalAlignment="Left"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></ContentControl></ScrollViewer>
            </Expander>
            <Grid Grid.Row="4" Visibility="{Binding HasDetail, Converter={StaticResource BoolVisibility}}" ColumnSpacing="{StaticResource Space16}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid RowSpacing="{StaticResource Space8}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="{StaticResource Space8}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickInput" IsEnabled="{Binding CanEdit}" PlaceholderText="Add item…" Text="{Binding QuickTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" KeyDown="OnQuickKey" AutomationProperties.AutomationId="ListQuickAdd" AutomationProperties.Name="Add item"/>
                        <Button Grid.Column="1" Content="Add" IsEnabled="{Binding CanEdit}" Command="{Binding QuickAddCommand}" AutomationProperties.AutomationId="AddListItem"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="{StaticResource Space8}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" AutomationProperties.AutomationId="ListItemFilter" AutomationProperties.Name="Item filter"/>
                        <TextBox Grid.Column="1" PlaceholderText="Filter item titles" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ListItemSearch" AutomationProperties.Name="Filter item titles"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource BodyStyle}" Margin="0,12,0,0"/>
                        <ListView ItemsSource="{Binding Items}" SelectionMode="None" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="ListItems">
                            <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="{StaticResource Space8}" Padding="{StaticResource TaskRowPadding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" Tag="{Binding}" Click="OnCheck" AutomationProperties.Name="{Binding CheckLabel}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Tag="{Binding}" Click="OnEdit" Style="{StaticResource TaskTitleButtonStyle}" AutomationProperties.Name="{Binding EditLabel}"><StackPanel Opacity="{Binding Opacity}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource BodyStyle}"/></StackPanel></Button>
                                <Button Grid.Column="2" Content="⋯" Tag="{Binding}" AutomationProperties.Name="{Binding ActionsLabel}" VerticalAlignment="Center"><Button.Flyout><MenuFlyout Opening="OnItemActions"/></Button.Flyout></Button>
                            </Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="{Binding Totals}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding ShowItemPrices, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="ListTotals"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="{StaticResource Space8}"><Button IsEnabled="{Binding CanEdit}" Content="Clear checked items" Click="OnClearChecked"/><Button IsEnabled="{Binding CanEdit}" Content="Uncheck all" Command="{Binding UncheckAllCommand}"/></StackPanel>
                </Grid>
                <Border Grid.Column="1" Width="300" Background="{ThemeResource Surface}" BorderBrush="{ThemeResource Border}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="{StaticResource ContentPadding}" Visibility="{Binding HasItemEditor, Converter={StaticResource BoolVisibility}}">
                    <ScrollViewer><ContentControl IsEnabled="{Binding CanEdit}" HorizontalContentAlignment="Stretch"><StackPanel Spacing="{StaticResource Space8}">
                        <TextBlock Text="Edit item" FontSize="{StaticResource SectionTitle}"/>
                        <TextBox Header="Title" Text="{Binding ItemTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.AutomationId="ListItemTitle"/>
                        <TextBox Header="Quantity (optional)" Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowItemQuantity, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="ListItemQuantity"/>
                        <TextBox Header="Unit price (optional)" Text="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowItemPrices, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="ListItemPrice"/>
                        <TextBox Header="Note (optional)" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="50000" MinHeight="80" MaxHeight="160" AutomationProperties.AutomationId="ListItemNote"/>
                        <TextBox Header="Link (optional)" Text="{Binding Link, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" AutomationProperties.AutomationId="ListItemLink"/>
                        <Button Content="Save item" Command="{Binding SaveItemCommand}" AutomationProperties.AutomationId="SaveListItem"/>
                        <Button Content="Cancel edit" Command="{Binding CancelItemCommand}"/>
                    </StackPanel></ContentControl></ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
