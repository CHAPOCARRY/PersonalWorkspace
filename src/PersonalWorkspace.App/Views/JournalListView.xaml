<UserControl x:Class="PersonalWorkspace.App.Views.JournalListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource ContentPadding}" RowSpacing="{StaticResource Space8}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Journal" FontSize="{StaticResource SectionTitle}" /><TextBlock Text="{Binding Error}" Foreground="{ThemeResource Danger}" Style="{StaticResource BodyStyle}" /><TextBlock Text="No Journals here yet." Visibility="{Binding HasNoJournals, Converter={StaticResource BoolVisibility}}" Style="{StaticResource BodyStyle}" /></StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Rows}" SelectionMode="None" IsItemClickEnabled="False"><ListView.ItemTemplate><DataTemplate>
            <Grid ColumnSpacing="{StaticResource Space12}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Tag="{Binding}" Click="OnOpen" Style="{StaticResource TaskTitleButtonStyle}" AutomationProperties.Name="{Binding Title}"><StackPanel><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding State}" Style="{StaticResource BodyStyle}" /><TextBlock Text="{Binding Summary}" Style="{StaticResource BodyStyle}" MaxLines="2" /></StackPanel></Button>
                <Button Grid.Column="1" Content="Actions" Tag="{Binding}"><Button.Flyout><MenuFlyout Opening="OnActionsOpening" /></Button.Flyout></Button>
            </Grid>
        </DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
</UserControl>
