<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infrastructure="using:PersonalWorkspace.App.Infrastructure">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Background" Color="#F7F8FA" />
            <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSecondary" Color="#F0F2F5" />
            <SolidColorBrush x:Key="Border" Color="#E1E5EB" />
            <SolidColorBrush x:Key="TextPrimary" Color="#202833" />
            <SolidColorBrush x:Key="TextSecondary" Color="#596575" />
            <SolidColorBrush x:Key="Accent" Color="#345ECC" />
            <SolidColorBrush x:Key="Success" Color="#237A4B" />
            <SolidColorBrush x:Key="Warning" Color="#926000" />
            <SolidColorBrush x:Key="Danger" Color="#B32C37" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <infrastructure:BooleanVisibilityConverter x:Key="BoolVisibility" />
    <infrastructure:OrganizationColorConverter x:Key="OrganizationColor" />
    <x:Double x:Key="OrganizationIndicatorSize">8</x:Double>
    <x:Double x:Key="CalendarDayWidth">112</x:Double>
    <x:Double x:Key="CalendarDayHeight">120</x:Double>
    <x:Double x:Key="EventListHeight">280</x:Double>
    <x:Double x:Key="ProfileFormWidth">480</x:Double>
    <x:Double x:Key="TaskDetailWidth">920</x:Double>
    <x:Double x:Key="TaskDescriptionHeight">160</x:Double>
    <Thickness x:Key="TaskRowPadding">0,8</Thickness>
    <Style x:Key="TaskTitleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <x:Double x:Key="ProfileNameWidth">240</x:Double>
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <x:Double x:Key="Space32">32</x:Double>
    <x:Double x:Key="Space48">48</x:Double>
    <x:Double x:Key="PageTitle">28</x:Double>
    <x:Double x:Key="SectionTitle">20</x:Double>
    <x:Double x:Key="CardTitle">16</x:Double>
    <x:Double x:Key="Body">14</x:Double>
    <x:Double x:Key="Small">12</x:Double>
    <x:Double x:Key="TopBarHeight">48</x:Double>
    <x:Double x:Key="SidebarWidth">240</x:Double>
    <x:Double x:Key="SidebarCollapsedWidth">64</x:Double>
    <Thickness x:Key="ContentPadding">24</Thickness>
    <Thickness x:Key="SidebarFooterMargin">8</Thickness>
    <Thickness x:Key="TopBarPadding">8,0,16,0</Thickness>
    <Thickness x:Key="CardPadding">24</Thickness>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
    </Style>
    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Body}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
    </Style>
</ResourceDictionary>
